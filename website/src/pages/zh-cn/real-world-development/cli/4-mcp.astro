---
const target = `${import.meta.env.BASE_URL}zh-cn/real-world-development/cli/6-mcp-playwright/`;
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN" data-pagefind-ignore>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <title>正在跳转到使用 Playwright MCP 进行验证的课程</title>
  </head>
  <body>
    <a href={target}>本课程已迁移。请继续学习使用 Playwright MCP 进行验证的课程。</a>
  </body>
</html>
